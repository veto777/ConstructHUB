# Every 15 minutes. A run with no new issues exits at once (no Claude, no cost);
# run.sh holds a lock, so runs never overlap. docs/ops/ISSUE-DESK.md
[Unit]
Description=ConstructHUB issue desk every 15 minutes

[Timer]
OnCalendar=*:0/15
RandomizedDelaySec=60
Persistent=false
Unit=constructhub-issue-desk.service

[Install]
WantedBy=timers.target
