# ConstructHUB issue desk — tower config. Copy to ops/issue-desk/.env, then: chmod 600 ops/issue-desk/.env
# (.env is gitignored; run.sh reads it without sourcing and never exports it to Claude.)

# The same value as ISSUE_DESK_SECRET in the app's .env on vb11 (~/ConstructHUB-live/.env).
# At least 24 characters; generate with: openssl rand -hex 32
ISSUE_DESK_SECRET=

# The app, over the tailnet (not the public domain: the internal API answers 404 through Cloudflare).
ISSUE_DESK_APP_URL=http://100.76.165.33:8110

# Spending cap per run (Claude's computed cost; a run happens only when new issues exist).
ISSUE_DESK_MAX_BUDGET_USD=10
# Optional: a model alias (opus, sonnet) — empty = the account's default.
ISSUE_DESK_MODEL=
# Optional: at most this many Claude runs per day (default 6); later issues wait for tomorrow.
ISSUE_DESK_MAX_RUNS_PER_DAY=6
# Optional: minutes before a run is stopped (default 60).
ISSUE_DESK_TIMEOUT_MIN=60

# Optional: a DEVELOPMENT database for Claude's DB-backed tests (never production). Empty = pure tests only.
ISSUE_DESK_TEST_DATABASE_URL=

# Defaults, change only if you moved things:
# ISSUE_DESK_WORKTREE=/home/veto/ConstructHUB-issue-desk
# ISSUE_DESK_CLAUDE_CONFIG_DIR=/home/veto/.claude-accountB
