# ConstructHUB Call Assistant engine — copy to voice/.env (gitignored). ConstructHUB's own
# values only: never paste another project's tokens here. docs/call-assistant/SPEC.md § Env.

# Where to listen. VOICE_BIND is comma-separated; the tailnet address lets the vb11 app reach us.
VOICE_PORT=8152
VOICE_BIND=127.0.0.1,100.90.145.13

# The ConstructHUB app (vb11) and the shared bearer — the SAME value as the app's VOICE_INTERNAL_SECRET.
VOICE_APP_URL=https://constructhub.us
VOICE_INTERNAL_SECRET=

# What SignalWire is pointed at (the app proxies /voice/* here). The media WebSocket is derived from it.
VOICE_PUBLIC_BASE=https://constructhub.us/voice

# The brain. Default = ConstructHUB's OpenAI-compatible provider (the operator copies the app's
# AI_INTEGRATIONS_OPENAI_* / AI_MODEL values). VOICE_AI_PROVIDER=anthropic needs VOICE_ANTHROPIC_API_KEY
# (a ConstructHUB-owned key; none exists today).
VOICE_AI_PROVIDER=openai
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_MODEL=truthcode-api
AI_TIMEOUT_MS=12000
# VOICE_ANTHROPIC_API_KEY=
# VOICE_ANTHROPIC_MODEL=claude-haiku-4-5

# SignalWire (the ConstructHUB space) — used only to VERIFY inbound webhooks: the signing key checks the
# request signature; the project credentials look the CallSid up when no signature matches.
SIGNALWIRE_SPACE_URL=
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_SIGNING_KEY=

# Speech
VOICE_WHISPER_MODEL=large-v3-turbo
VOICE_TTS_DEVICE=cuda
VOICE_STT_DEVICE=cuda
VOICE_MODELS_DIR=./models

# Recordings are written here, uploaded to the app (R2) at the end of the call, then deleted on success.
VOICE_RECORDINGS_DIR=./recordings

# Local tuning (defaults are Alpine's proven values)
# VOICE_GREETING_DELAY_S=3
# VOICE_SKIP_SIGNATURE=0      # 1 only on a dev box with no public webhook
