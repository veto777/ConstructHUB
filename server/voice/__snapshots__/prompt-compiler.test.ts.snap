  "escalationKinds": [],
  "greeting": "Thank you for calling Acme Roofing, this is Janice — calls may be recorded. What can we help you with today?",
  "hash": "987d22e6b6899ea5735b1819f3822b02cbc5e21361dd92eeb0855e8b69465a55",
  "intake": [
    {
      "choices": [],
