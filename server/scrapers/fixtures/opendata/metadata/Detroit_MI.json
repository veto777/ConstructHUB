:null,"defaultValue":null,"description":"{\"value\": \"The Type of Use that the permit applicant proposed for the relevant building space after the permitted work is completed.\", \"fieldValueType\": \"typeOrCategory\"}"},{"name":"use_group","type":"esriFieldTypeString","actualType":"nvarchar","alias":"Use Group","sqlType":"sqlTypeNVarchar","length":256,"nullable":true,"editable":true,"domain":null,"defaultValue":null,"description":"{\"value\": \"\", \"fieldValueType\": \"typeOrCategory\"}"},{"name":"zoning_designation","type":"esriFieldTypeString","actualType":"nvarchar","alias":"Zoning Designation","sqlType":"sqlTypeNVarchar","length":256,"nullable":true,"editable":true,"domain":null,"defaultValue":null,"description":"{\"value\": \"The type of zoning district where the building is located. The City of Detroit Zoning Ordinance is written by the City Planning Commission and approved by City Council.\", \"fieldValueType\": \"typeOrCategory\"}"},{"name":"num_stories","type":"esriFieldTypeDouble","actualType":"float","alias":"Number of Stories","sqlType":"sqlTypeFloat","nullable":true,"editable":true,"domain":null,"defaultValue":null,"description":"{\"value\": \"Stories is the total number of floors in the building. Permits may be issued for individual floors or groups of floors.\", \"fieldValueType\": \"countOrAmount\"}"},{"name":"num_units","type":"esriFieldTypeDouble","actualType":"float","alias":"Number of Units","sqlType":"sqlTypeFloat","nullable":true,"editable":true,"domain":null,"defaultValue":null,"description":"{\"value\": \"\", \"fieldValueType\": \"countOrAmount\"}"},{"name":"amt_permit_cost","type":"esriFieldTypeDouble","actualType":"float","alias":"amt_permit_cost","sqlType":"sqlTypeFloat","nullable":true,"editable":true,"domain":null,"defaultValue":null},{"name":"amt_estimated_contractor_cost","type":"esriFieldTypeDouble","actualType":"float","alias":"Contractor Estimated Cost","sqlType":"sqlTypeFloat","nullable":true,"editable":true,"domain":null,"defau