{"help":"https://data.sanantonio.gov/api/3/action/help_show?name=package_show","success":true,"result":{"author":"Jorge Manzano","author_email":"jorge.manzano@sanantonio.gov","creator_user_id":"fcb94ca2-66dd-4cb9-ace6-0543ba3af82f","id":"05012dcb-ba1b-4ade-b5f3-7403bc7f52eb","isopen":true,"license_id":"cc-by","license_title":"Creative Commons Attribution","license_url":"http://www.opendefinition.org/licenses/cc-by","maintainer":"Jorge Manzano","maintainer_email":"jorge.manzano@sanantonio.gov","metadata_created":"2018-05-08T14:11:19.368296","metadata_modified":"2026-10-04T04:01:35.045468","name":"building-permits","notes":"The City requires permits for commercial and residential development, such as new single-family homes, commercial construction, remodels, additions and related activity like trade (mechanical, electrical, and plumbing) work. City review ensures that construction projects adhere to the City\u2019s adopted Building Codes and the Unified Development Code to enhance the health and safety for you, your family and our community. \r\n                                                                                                                                                                                                                                                                                                                                                                                                                                           \r\nThe datasets below are provided as-is as a record of building activity in San Antonio. For any additional information not contained below, or for information and documentation related to building activity, a request for information (\u201copen records request\u201d) is needed; please refer to the City of San Antonio Open Government Request site  at https://www.sa.gov/Directory/Departments/CE/Open-Records-Request to submit a request.","num_resources":4,"num_tags":5,"organization":{"id":"9a52392a-3a73-4241-a11e-3d442a96d825","name":"land-and-building-development","title":"Land and Building Development","type":"organization","description":"The City of San Antonio\u2019s Development Services Department is responsible for coordinating land and building development throughout the City. In partnership with other City departments, Development Services helps homeowners, business owners, and those in the commercial industry plan and execute development projects. Projects can be as simple as a kitchen renovation in a home and as complex as constructing a new building on an untouched piece of property.","image_url":"2018-10-11-160605.492804BIDATAANNPWAP01BIAnalyticsOpenGovTechnical-DocslayoutNEWCRMIconsLandDevelopm","created":"2018-05-08T14:07:59.609474","is_organization":true,"approval_status":"approved","state":"active"},"owner_org":"9a52392a-3a73-4241-a11e-3d442a96d825","private":false,"state":"active","title":"Building Permits","type":"dataset","url":"Hansen, Accela","version":"","extras":[{"key":"accessLevel","value":"public"},{"key":"contact_email","value":"DSDSupportServices@sanantonio.gov"},{"key":"contact_name","value":"Jorge Manzano"}],"groups":[{"description":"","display_name":"Housing, Building and Construction","id":"b636820d-72f7-49b0-aa8e-9c782485f858","image_display_url":"https://data.sanantonio.gov/uploads/group/2018-10-10-120622.246334BIDATAANNPWAP01BIAnalyticsOpenGovTechnical-DocslayoutNEWCRMIconsHousing.png","name":"housing-building-and-construction","title":"Housing, Building and Construction"}],"resources":[{"cache_last_updated":null,"cache_url":null,"ckan_url":"https://data.sanantonio.gov","created":"2025-09-04T20:49:24.746537","datastore_active":true,"datastore_contains_all_records_of_source_file":true,"description":"All building, trade (MEP) and garage sale permits issued from 2020 through 2024.","format":"CSV","hash":"16e316329a96aafc4d2de416cb6f7316","id":"c22b1ef2-dcf8-4d77-be1a-ee3638092aab","ignore_hash":false,"is_data_dict_populated":true,"last_