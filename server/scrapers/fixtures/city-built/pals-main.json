
<!DOCTYPE html>
<html id="palsonline" lang="en" ng-class="{'pc-public': appTheme !== undefined}" data-ng-strict-di>
<head>
<base href="/palsonline/" />
  <!-- Meta -->
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge, chrome=1">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Pals">
  <meta name="keywords" content="">
  <meta name="author" content="Pierce County">
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
  <meta http-equiv="expires" content="0" />
  <meta http-equiv="pragma" content="no-cache" />
  <meta name="theme-color" content="#1797be">

  <!-- <title>Online Permits</title> -->
  <title ng-bind="tabTitle"></title>

  <!-- icons -->
  <!-- favicon.ico?v=2 forces browser to repull favico everytime its refreshed -->
  <!-- http://stackoverflow.com/questions/2208933/how-do-i-force-a-favicon-refresh -->
  <link rel="icon" href="images/favicon.ico?v=2"/>
  <link rel="shortcut icon" href="images/favicon.ico?v=2">
  <link rel="apple-touch-icon" href="images/apple-touch-icon.png">
  <link rel="apple-touch-icon" sizes="114x114" href="images/apple-touch-icon-retina.png">

    <!-- inject:unsupportedbrowser-js -->
    <script src="unsupported/unsupported5.2.13-001.js"></script>
    <!-- endinject -->

    <!-- inject:vendorjs -->
    <script src="vendor/vendor5.2.13-001.js"></script>
    <!-- endinject -->

    <!-- inject:js -->
    <script src="js/app5.2.13-001.js"></script>
    <script src="js/templates/templates5.2.13-001.js"></script>
    <!-- endinject -->

    <!-- inject:vendorcss -->
    <link rel="stylesheet" href="vendor/vendor5.2.13-001.css">
    <!-- endinject -->

    <!-- inject:themecss -->
    <link rel="stylesheet" href="vendor/pac-theme.css">
    <link rel="stylesheet" href="vendor/theme-public-sassy.css">
    <!-- endinject -->

    <!-- inject:css -->
    <link rel="stylesheet" href="css/app5.2.13-001.css">
    <link rel="stylesheet" href="styles.80e2b28813bfd663.css">
    <!-- endinject -->
  </head>


  <body data-ng-class="{'long-title': true, 'layout-fixed' : app.layout.isFixed, 'aside-collapsed' : app.layout.isCollapsed, 'layout-boxed' : app.layout.isBoxed,
  'noBackground' : appTheme !== undefined, 'applyHeight' : appTheme !== undefined}">
        <div uib-alert class="floatingAlert" ng-repeat="alert in alerts" ng-class="'alert-' + (alert.type || 'warning')" close="closeAlert($index)">{{alert.msg}}</div>

        <div data-ui-view="" data-autoscroll="false" data-ng-class="{'mainViewAnimation' : appTheme !== undefined, 'wrapper' : appTheme !== undefined}"></div>

        <script type="text/javascript">
            window.appConfig = {
                // gulp version plugin prepends a "v" to the version
                "version": "v5.2.13-001",
                "pacVersion": "v11.21.0"
            };
        </script>
        <!-- inject:angular -->
        <script src="main.25282f6d27068072.js"></script>
        <script src="polyfills.486e6add05d4aeda.js"></script>
        <script src="runtime.f4223a3c7e6d9b6d.js"></script>
        <!-- endinject -->

  </body>

    <!-- Google tag (gtag.js) -->
    <script async src=https://www.googletagmanager.com/gtag/js?id=G-LX80J66P7D></script>
    <script> window.dataLayer = window.dataLayer || [];
                function gtag(){dataLayer.push(arguments);}
                gtag('js', new Date());
                gtag('config', 'G-LX80J66P7D');
    </script>
</html>
