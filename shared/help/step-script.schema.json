{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constructhub.us/schemas/tutorial-step-script.json",
  "title": "Tutorial step script",
  "description": "One walkthrough video: the steps a recorder plays against a demo account, with the caption and the narration line for each. Twin of shared/help/step-script.ts (zod).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "helpKey",
    "title",
    "viewport",
    "steps"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "helpKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "A key of HELP_ENTRIES (shared/help/registry.ts)."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 320,
          "maximum": 3840
        },
        "height": {
          "type": "integer",
          "minimum": 480,
          "maximum": 2160
        }
      }
    },
    "narrator": {
      "enum": [
        "janice",
        "gabe",
        "sofia",
        "maya",
        "marcus",
        "ethan"
      ],
      "default": "janice"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "caption",
          "narration"
        ],
        "properties": {
          "selector": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "action": {
            "enum": [
              "goto",
              "highlight",
              "hover",
              "click",
              "type",
              "select",
              "press",
              "scroll",
              "wait",
              "back",
              "upload",
              "drag",
              "session",
              "fixture",
              "wait-for"
            ]
          },
          "url": {
            "type": "string",
            "pattern": "^/",
            "maxLength": 300,
            "description": "goto: the path to open. session: the path that session opens first."
          },
          "value": {
            "type": "string",
            "maxLength": 500
          },
          "caption": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "narration": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "holdMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30000
          },
          "redact": {
            "type": "boolean"
          },
          "chapter": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60,
            "description": "Starts a YouTube chapter with this name."
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "string",
              "maxLength": 120,
              "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*\\.[a-z0-9]+$"
            },
            "description": "upload: demo files under scripts/tutorials/assets/, e.g. photos/site-02.jpg."
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "drag: the selector of where to drop."
          },
          "session": {
            "type": "string",
            "pattern": "^(owner|client|member:[A-Za-z][A-Za-z .'&-]{1,60})$",
            "description": "session: whose browser the camera shows from here on; with url or fixture (+ input), where it opens."
          },
          "fixture": {
            "type": "string",
            "maxLength": 60,
            "pattern": "^[a-z][a-z-]*\\.[a-z][a-zA-Z]*$",
            "description": "fixture: \"<provider>.<action>\" (docs/tutorials/FIXTURES.md)."
          },
          "input": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "description": "fixture: what the helper takes."
          },
          "open": {
            "type": "boolean",
            "description": "fixture: open the address the helper answers with in the current session."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "wait-for: text to wait for."
          },
          "state": {
            "enum": [
              "visible",
              "hidden"
            ],
            "description": "wait-for: visible (default) or hidden."
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 100,
            "maximum": 120000,
            "description": "wait-for: how long to wait (default 15000)."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "const": "goto"
                }
              }
            },
            "then": {
              "required": [
                "url"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "enum": [
                    "highlight",
                    "hover",
                    "click",
                    "type",
                    "select",
                    "scroll",
                    "upload",
                    "drag"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "selector"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "enum": [
                    "type",
                    "select",
                    "press"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "value"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "upload"
                }
              }
            },
            "then": {
              "required": [
                "files"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "drag"
                }
              }
            },
            "then": {
              "required": [
                "to"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "session"
                }
              }
            },
            "then": {
              "required": [
                "session"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "fixture"
                }
              }
            },
            "then": {
              "required": [
                "fixture"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "wait-for"
                }
              }
            },
            "then": {
              "anyOf": [
                {
                  "required": [
                    "selector"
                  ]
                },
                {
                  "required": [
                    "text"
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "zoom": {
      "type": "number",
      "minimum": 1,
      "maximum": 3,
      "default": 1,
      "description": "Device scale factor: the video is viewport × zoom pixels. House style: 1024×576 at 1.875 → 1920×1080."
    },
    "youtube": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "tags"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 10,
          "maxLength": 70
        },
        "description": {
          "type": "string",
          "minLength": 40,
          "maxLength": 600
        },
        "tags": {
          "type": "array",
          "minItems": 3,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40
          }
        },
        "playlist": {
          "type": "string",
          "default": "ConstructHUB CRM tutorials"
        },
        "category": {
          "enum": [
            27,
            28
          ],
          "default": 28
        }
      }
    },
    "thumbnail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "step"
      ],
      "properties": {
        "headline": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40,
          "description": "2-5 words, true to the video."
        },
        "accent": {
          "type": "string",
          "maxLength": 20
        },
        "kicker": {
          "type": "string",
          "default": "CRM Tutorial"
        },
        "step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 79
        }
      }
    }
  }
}
