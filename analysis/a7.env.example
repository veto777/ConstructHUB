# Lane a7 integration settings (merge into the owner's environment; do not commit real credentials)
DOMAINS_WORKER_ENABLED=false
DOMAINS_EGRESS_IP=
# Existing encryption key: stable 32 random bytes encoded as base64. Back up securely.
GBP_TOKEN_KEY=
# Forwarding works without Google restricted scopes. Owner must configure a receiving email worker.
INBOUND_MAIL_DOMAIN=
INBOUND_MAIL_SECRET=
# Enable only after the applicable Google verification / annual CASA assessment.
GMAIL_OAUTH_ENABLED=false
# Shared OAuth application credentials already used by GBP:
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
# Add a separate callback: https://<app-host>/api/mail-alerts/oauth/callback
# Local development / tests only:
EMAIL_FORCE_SINK=1
