# ConstructHUB environment template
# Copy this file to `.env`, then paste in the real values from
# Replit -> Tools -> Secrets -> "Edit as JSON" (shows all keys + values at once).
# NEVER commit the filled-in .env file to git.

# --- Core ---
DATABASE_URL=            # PostgreSQL connection string
SESSION_SECRET=          # REQUIRED in production; long random string for signing session cookies
PORT=5000
# Default to production. Set to "development" ONLY on your own machine.
NODE_ENV=production

# Local dev only: treat anonymous requests as user id 1 (bypasses auth).
# Requires NODE_ENV != production AND this flag set to "true". Never set on a
# deployed box — leaving it unset keeps auth enforced.
# DEV_AUTH_BYPASS_USER1=true

# --- Google OAuth login + Places ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PLACES_API_KEY=

# --- Google Ads / LSA API (may be empty if not connected yet) ---
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Legacy compatibility only: Google moved Ads API access to Cloud projects on 2026-09-09.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Set true after the OAuth client project has approved Ads API access (tokenless setup).
GOOGLE_ADS_PROJECT_ACCESS_ENABLED=false
# Agency MCC jobs are off until explicitly enabled. Keep false in feature lanes.
GOOGLE_ADS_WORKER_ENABLED=false
# Agency default only; each owner connects and verifies their own MCC ID.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional overrides:
# GOOGLE_ADS_API_VERSION=v25
# GOOGLE_ADS_REDIRECT_URI=https://constructhub.us/api/ads/callback
# LSA_OAUTH_REDIRECT_URI=      # full callback URL for local dev
# LSA_PUBLIC_BASE_URL=         # base origin, defaults to https://constructhub.us

# --- Cloudflare R2 object storage ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=

# --- Email (Gmail SMTP) ---
SMTP_EMAIL=
SMTP_APP_PASSWORD=
SMTP_EMAIL_BACKUP=
SMTP_APP_PASSWORD_BACKUP=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Frontend publishable key (safe to expose, but keep consistent):
# STRIPE_PUBLISHABLE_KEY=

# --- OpenAI (Replit AI integration on Replit; use your own key locally) ---
AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=   # leave empty to use api.openai.com locally

# --- Canonical link bases (production) ---
# When set, these win over Host-header derivation for every link the system
# generates (invites, magic links, estimate/invoice/change-order emails).
# Unset = derive from the request's allowlisted Host (fine for dev/tests).
PORTAL_URL=https://portal.constructhub.us   # the CRM — invite/reset/estimate/invoice links
CLIENT_URL=https://client.constructhub.us   # homeowner client portal — magic links
APP_URL=https://constructhub.us             # marketing apex — last-resort fallback

# --- Optional ---
TELEGRAM_BOT_TOKEN=      # only if using LSA Telegram notifications
# CHROMIUM_PATH=         # path to Chromium for the scraper, if needed locally

# --- SMS (SignalWire, platform sender — contractor account notifications only) ---
# SIGNALWIRE_SPACE_URL=construct-hub.signalwire.com
# SIGNALWIRE_PROJECT_ID=
# SIGNALWIRE_API_TOKEN=
# SIGNALWIRE_FROM_NUMBER=+13605857553   # must be attached to the approved 10DLC campaign
# SIGNALWIRE_SIGNING_KEY=               # Dashboard → API Credentials → Signing Key. SignalWire signs
#                                       # inbound webhooks with THIS, not the API token; unset = accept + warn

# reCAPTCHA for the free website scan (server/sitescan). The Hub assistant does not use it:
# signed-out visitors only get cached preset answers.
RECAPTCHA_SECRET_KEY=
VITE_RECAPTCHA_SITE_KEY=

# Hub, the corner assistant (server/hub). All optional; defaults shown. In production chat is
# refused unless the AI base URL's host is in HUB_AI_HOSTS and AI_MODEL equals HUB_EXPECTED_MODEL.
# HUB_AI_HOSTS=127.0.0.1:8250
# HUB_EXPECTED_MODEL=truthcode:38
# HUB_AI_TIMEOUT_MS=45000          # capped by AI_TIMEOUT_MS
# HUB_GLOBAL_DAILY_CAP=1500        # model calls per UTC day, all users
# HUB_MAX_CONCURRENCY=3
# HUB_TURN_KEY=                    # signs chat turns; unset = derived from SESSION_SECRET
# HUB_WARM_PRESETS=true            # false skips generating preset answers at boot

# Account security: REQUIRED in production. Generate once: openssl rand -base64 32
# Retain this key across restarts/backups; changing it requires re-encrypting existing credentials.
# Protects GBP access/refresh tokens and authenticator secrets using AES-256-GCM.
GBP_TOKEN_KEY=

# Google Business Posts & Photos. Keep the worker disabled in development lanes.
GBP_CONTENT_WORKER_ENABLED=false
# OPTIONAL public HTTPS origin serving the R2 media/ prefix. Unset = Google fetches photos through 1-hour
# HMAC-signed /api/public/gbp-media links (recommended; no public bucket needed).
GBP_MEDIA_PUBLIC_BASE_URL=
# Vision-capable model, using the existing AI_INTEGRATIONS_OPENAI_* credentials.
GBP_CONTENT_AI_MODEL=gpt-4o-mini

# Social Media (customer supplies their own Blotato key in the UI).
# Required to connect: stable 32-byte random key encoded as 64 hex characters.
# Store securely; changing it requires reconnecting all Blotato customers.
SOCIAL_ENCRYPTION_KEY=
# Keep true in feature lanes/tests. Unset/false enables the durable 15s worker.
SOCIAL_WORKER_DISABLED=true
# Uses existing AI_INTEGRATIONS_OPENAI_API_KEY / AI_INTEGRATIONS_OPENAI_BASE_URL.
SOCIAL_AI_MODEL=gpt-4o-mini

# Cloudflare + Search Console (separate grants, encrypted with GBP_TOKEN_KEY)
# Leave disabled in test lanes; tests inject mocked provider clients.
EDGE_SEARCH_WORKER_ENABLED=false
# Agency membership mode: only this ConstructHUB owner may use the shared credential.
CLOUDFLARE_AGENCY_USER_ID=
CLOUDFLARE_AGENCY_EMAIL=
CLOUDFLARE_AGENCY_TOKEN=
# Google OAuth also needs /api/gsc/callback and the webmasters Data Access scope.
